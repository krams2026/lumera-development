# --- Доставка заявок: достаточно одного из вариантов ---
# Вариант 1 (рекомендуется): Lumera Desk (база, /requests, кнопки). URL только https и без IP-адресов.
LUMERA_DESK_URL=
LUMERA_DESK_API_SECRET=
# Вариант 2 (запасной): прямое сообщение владельцу. TELEGRAM_CHAT_ID: числовой ID владельца (как ADMIN_ID в боте)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Защита от ботов (необязательно, бесплатно): Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# --- Диагностика: GET /api/lead с заголовком Authorization: Bearer <значение>. Без неё эндпоинт отвечает только {"ok":true} ---
DIAGNOSTICS_TOKEN=
# Все значения, кроме NEXT_PUBLIC_*, только серверные
NEXT_PUBLIC_SITE_URL=https://lumera-development.vercel.app
